# 複製成 .env 後填值（.env 已被 .gitignore，只給本地開發用）。
# 部署前必打三個 secret（wrangler deploy 不會上傳 .env）：
#   wrangler secret put GOOGLE_CLIENT_ID
#   wrangler secret put GOOGLE_CLIENT_SECRET
#   wrangler secret put SESSION_SECRET
# 注意：不要另外建 .dev.vars —— 它存在時 .env 會被 wrangler 整個忽略。

# Google OAuth（Google Cloud Console → API 和服務 → 憑證 → OAuth 2.0 用戶端）
# 重新導向 URI 加：http://localhost:5173/api/auth/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# session cookie 簽名密鑰（隨便一串長亂數，例：openssl rand -hex 32）
SESSION_SECRET=請換成長亂數

# 管理員名單（Google email，逗號分隔）→ 場地/陀螺後台權限
ADMIN_EMAILS=agito723@gmail.com

# VITE_ 前綴 = 前端（瀏覽器）看得到的變數；目前沒有需要的
