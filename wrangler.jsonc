{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beyblade-battle-field",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-06-01",
  // 靜態資產：不存在的路徑回 public/404.html（HTTP 404，不再 soft 404）。
  // run_worker_first：/api/* 與「頁面」先進 Worker（worker/pages.ts）：
  //   "/" 依登入分流（未登入＝公開介紹頁 landing.html、已登入＝SPA 大廳）；
  //   其餘為 vue-router 路由（src/router.ts），回 SPA 殼 index.html 並加 noindex。
  //   新增前端路由時兩邊都要加（test/pages.test.ts 會交叉比對 router.ts / 本檔 / worker/pages.ts）。
  // directory：dev/build 時 @cloudflare/vite-plugin 會自己管（忽略此值）；
  // 寫上是為了讓「不經 vite 的 wrangler 指令」（如 CI 裡 build 前跑 d1 migrations）也能解析此設定檔
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/",
      "/landing",
      "/landing/",
      "/login",
      "/login/",
      "/roster",
      "/roster/",
      "/settings",
      "/settings/",
      "/room/*",
      "/admin/*",
      "/test/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  // 非秘密環境變數（本地開發時 .env 會覆寫）。
  // 部署前必打三個 secret（wrangler deploy 不會上傳 .env）：
  //   wrangler secret put GOOGLE_CLIENT_ID
  //   wrangler secret put GOOGLE_CLIENT_SECRET
  //   wrangler secret put SESSION_SECRET
  // 漏打時 /api/auth/* 會回 503 並在 log 指名缺哪個。
  "vars": {
    "ADMIN_EMAILS": "agito723@gmail.com"
  },
  // 打擊音效取樣（CC0，Kenney impact pack 轉檔）：音檔直傳 R2 不進 repo，
  // 上傳指令見 scripts/upload-sfx.sh；前端載入失敗會自動回退合成音效。
  "r2_buckets": [
    {
      "binding": "SFX",
      "bucket_name": "beyblade-sfx"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beyblade-battle-field",
      // 正式 D1（本地開發仍走 .wrangler/state 的本地 SQLite，不會碰到它）
      "database_id": "687dd034-f206-40c0-9aa8-6cb9aad7c622",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BATTLE_ROOM",
        "class_name": "BattleRoomDO"
      },
      {
        "name": "LOBBY",
        "class_name": "LobbyDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BattleRoomDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["LobbyDO"]
    }
  ]
}
