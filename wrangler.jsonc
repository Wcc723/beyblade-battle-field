{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beyblade-battle-field",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-06-01",
  // SPA：非資產路徑回 index.html（vue-router history mode）；/api/* 一律先進 Worker
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
  // 之後階段陸續加入：
  // Phase 2: GOOGLE_CLIENT_ID/SECRET（secret）、ADMIN_EMAILS（vars）、D1 binding
  // Phase 4: Battle Room Durable Object
  // Phase 5: Lobby Durable Object
}
